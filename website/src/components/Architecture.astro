---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import type { Lang, T } from '~/i18n/ui';

interface Props {
  t: T;
  lang: Lang;
}
const { t } = Astro.props;

const accents = [
  { dot: 'bg-jade-500', text: 'text-jade-600', glow: 'bg-jade-400/15', icon: 'split' },
  { dot: 'bg-cyan-500', text: 'text-cyan-600', glow: 'bg-cyan-400/15', icon: 'bridge' },
  { dot: 'bg-fg-muted', text: 'text-fg', glow: 'bg-fg/10', icon: 'rust' },
];
const layers = t.arch.layers.map((l, i) => ({ ...l, ...accents[i] }));
---

<section id="architecture" class="section">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.arch.eyebrow} title={t.arch.title} subtitle={t.arch.subtitle} />

    <div class="relative mt-14">
      <div class="relative grid grid-cols-1 items-stretch gap-4 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)] lg:gap-3">
        {
          layers.map((l, i) => [
            i > 0 && (
              <div class="reveal flex items-center justify-center" data-delay={i * 90 - 45} aria-hidden="true">
                <span class="inline-flex h-9 w-9 rotate-90 items-center justify-center rounded-full border border-jade-500/40 bg-surface text-jade-600 shadow-sm lg:rotate-0">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 8h15l-3-3M20 16H5l3 3" />
                  </svg>
                </span>
              </div>
            ),
            <div class="reveal" data-delay={i * 90}>
              <div class="ring-aura card card-hover relative h-full overflow-hidden p-6 sm:p-7">
                <div class={`absolute -right-6 -top-6 h-24 w-24 rounded-full ${l.glow} blur-2xl`} />
                <div class="relative">
                  <div class="flex items-center justify-between">
                    <span class={`inline-flex h-11 w-11 items-center justify-center rounded-xl border border-fg/10 bg-fg/[0.02] ${l.text}`}>
                      <Icon name={l.icon} size={22} />
                    </span>
                    <span class="font-mono text-xs text-fg-dim">0{i + 1}</span>
                  </div>
                  <h3 class="mt-5 font-display text-2xl font-semibold">{l.tag}</h3>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-fg/8 bg-fg/[0.03] px-2.5 py-1 text-xs text-fg-muted">
                      <span class={`h-1.5 w-1.5 rounded-full ${l.dot}`} />
                      {l.runs}
                    </span>
                    <span class="rounded-full border border-fg/8 bg-fg/[0.03] px-2.5 py-1 text-xs text-fg-muted">
                      {l.owns}
                    </span>
                  </div>
                  <p class="mt-4 text-[0.95rem] leading-relaxed text-fg-muted">{l.desc}</p>
                </div>
              </div>
            </div>,
          ])
        }
      </div>

      <p class="reveal mt-8 text-center font-mono text-sm text-fg-dim">{t.arch.footnote}</p>
    </div>
  </div>
</section>

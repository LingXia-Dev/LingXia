---
import Logo from './Logo.astro';
import { withBase, GITHUB_URL } from '~/lib/url';
import { langHome, type Lang, type T } from '~/i18n/ui';

interface Props {
  t: T;
  lang: Lang;
}
const { t, lang } = Astro.props;

const links = [
  { href: '#architecture', label: t.nav.architecture },
  { href: '#features', label: t.nav.features },
  { href: '#development', label: t.nav.development },
  { href: '#build', label: t.nav.build },
  { href: '#ai', label: t.nav.ai },
];
const home = withBase(langHome(lang));
const docs = withBase(lang === 'zh' ? '/zh/guide/introduction' : '/guide/introduction');
---

<header
  id="nav"
  class="fixed inset-x-0 top-0 z-50 transition-[background,border-color,backdrop-filter] duration-300"
  data-nav
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
    <a href={home} class="rounded-lg" aria-label="LingXia home">
      <Logo size={30} />
    </a>

    <!-- desktop links -->
    <div class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-fg-muted transition-colors hover:text-fg"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={docs}
        class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-fg-muted transition-colors hover:text-fg"
      >
        {t.nav.docs}
      </a>
    </div>

    <div class="flex items-center gap-2.5">
      <!-- language switch -->
      <div class="hidden items-center rounded-lg border border-fg/10 bg-surface/70 p-0.5 text-xs font-medium sm:flex">
        <a
          href={withBase(langHome('en'))}
          class={`rounded-md px-2.5 py-1 transition-colors ${lang === 'en' ? 'bg-fg/8 text-fg' : 'text-fg-dim hover:text-fg'}`}
          >EN</a
        >
        <a
          href={withBase(langHome('zh'))}
          class={`rounded-md px-2.5 py-1 transition-colors ${lang === 'zh' ? 'bg-fg/8 text-fg' : 'text-fg-dim hover:text-fg'}`}
          >中文</a
        >
      </div>

      <button
        type="button"
        data-theme-toggle
        aria-label={t.nav.theme}
        title={t.nav.theme}
        class="inline-flex rounded-lg p-2 text-fg-muted transition-colors hover:bg-fg/5 hover:text-fg"
      >
        <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
        </svg>
      </button>

      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="hidden rounded-lg p-2 text-fg-muted transition-colors hover:bg-fg/5 hover:text-fg sm:inline-flex"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 5 18 5.3 18 5.3c.6 1.7.1 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>

      <a href={docs} class="btn btn-primary hidden h-9 px-4 py-0 text-sm md:inline-flex">
        {t.nav.getStarted}
      </a>

      <!-- mobile toggle -->
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-label={t.nav.menu}
        class="inline-flex items-center justify-center rounded-lg p-2 text-fg transition-colors hover:bg-fg/5 lg:hidden"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- mobile panel -->
  <div
    data-nav-panel
    hidden
    class="border-t border-fg/5 bg-surface/95 px-5 py-4 backdrop-blur-xl lg:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        links.map((l) => (
          <a href={l.href} data-nav-link class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted hover:bg-fg/5 hover:text-fg">
            {l.label}
          </a>
        ))
      }
      <a href={docs} class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted hover:bg-fg/5 hover:text-fg">{t.nav.docs}</a>
      <div class="mt-2 flex items-center gap-2">
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn btn-ghost flex-1 text-sm">{t.nav.github}</a>
        <a href={docs} class="btn btn-primary flex-1 text-sm">{t.nav.getStarted}</a>
      </div>
      <div class="mt-2 flex items-center gap-2 text-sm">
        <a href={withBase(langHome('en'))} class={lang === 'en' ? 'font-semibold text-jade-600' : 'text-fg-dim'}>English</a>
        <span class="text-fg-dim">·</span>
        <a href={withBase(langHome('zh'))} class={lang === 'zh' ? 'font-semibold text-jade-600' : 'text-fg-dim'}>中文</a>
      </div>
    </div>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('starlight-theme', next);
    } catch {}
    (window as unknown as { __lxApplyTheme?: () => void }).__lxApplyTheme?.();
  });
</script>

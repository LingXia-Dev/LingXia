---
// Platform marks in the same line style as Icon.astro (stroke = currentColor).
// Device-shaped & evocative rather than pixel-exact brand logos — the label
// next to each carries the identity.
interface Props {
  name: 'android' | 'ios' | 'macos' | 'windows' | 'harmony';
  size?: number;
  class?: string;
}
const { name, size = 26, class: cls = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  android: `
    <path d="M7.6 9 6 6.5M16.4 9 18 6.5"/>
    <path d="M5 14a7 7 0 0 1 14 0v3.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 17.5Z"/>
    <path d="M9.2 12.5h.01M14.8 12.5h.01"/>`,
  ios: `
    <rect x="7" y="3" width="10" height="18" rx="2.6"/>
    <path d="M10.5 5.4h3M11 18.4h2"/>`,
  macos: `
    <rect x="5" y="4.5" width="14" height="9.6" rx="1.6"/>
    <path d="M2.8 17.8h18.4"/>`,
  windows: `
    <path d="M4 5.8 10.7 4.8v6.4H4Z"/>
    <path d="M13 4.5 20 3.5v7.7h-7Z"/>
    <path d="M4 12.8h6.7v6.4L4 18.2Z"/>
    <path d="M13 12.8h7v7.7l-7-1Z"/>`,
  harmony: `
    <circle cx="12" cy="7.2" r="2.7"/>
    <circle cx="12" cy="16.8" r="2.7"/>
    <circle cx="7.2" cy="12" r="2.7"/>
    <circle cx="16.8" cy="12" r="2.7"/>`,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
  set:html={paths[name]}
/>

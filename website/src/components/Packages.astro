---
import SectionHeading from './SectionHeading.astro';
import type { Lang, T } from '~/i18n/ui';

interface Props {
  t: T;
  lang: Lang;
}
const { t } = Astro.props;

// Column per layer: View bindings / Logic + host clients / testing + internals.
const layerOf: Record<string, number> = {
  '@lingxia/react': 0,
  '@lingxia/vue': 0,
  '@lingxia/html': 0,
  '@lingxia/types': 1,
  '@lingxia/native': 1,
  '@lingxia/test': 2,
  '@lingxia/bridge': 2,
  '@lingxia/elements': 2,
};
const columns = t.packages.layers.map((label, i) => ({
  label,
  items: t.packages.items.filter((p) => (layerOf[p.name] ?? 2) === i),
}));
---

<section id="packages" class="section">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.packages.eyebrow} title={t.packages.title} subtitle={t.packages.subtitle} />

    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {
        columns.map((col, i) => (
          <div class="reveal card flex flex-col p-6 sm:p-7" data-delay={i * 80}>
            <span class="font-mono text-xs uppercase tracking-[0.18em] text-jade-700">{col.label}</span>
            <ul class="mt-4 divide-y divide-fg/8">
              {col.items.map((p) => (
                <li class="py-3.5 first:pt-0 last:pb-0">
                  <code class="block font-mono text-sm font-medium text-fg">{p.name}</code>
                  <p class="mt-1 text-sm leading-snug text-fg-muted">{p.desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

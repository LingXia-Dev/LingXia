---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
}
const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
const isCenter = align === 'center';
---

<div class={`reveal ${isCenter ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}`}>
  <span class={`text-sm font-semibold uppercase tracking-[0.18em] text-jade-600 ${isCenter ? '' : ''}`}>{eyebrow}</span>
  <h2 class="mt-3 text-balance font-display text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-[2.7rem]">
    {title}
  </h2>
  {subtitle && <p class={`mt-4 text-lg leading-relaxed text-fg-muted ${isCenter ? 'mx-auto max-w-xl' : ''}`}>{subtitle}</p>}
</div>

---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { guideUrl } from '~/lib/url';
import type { Lang, T } from '~/i18n/ui';

interface Props {
  t: T;
  lang: Lang;
}

const { t, lang } = Astro.props;
const tools = [t.devtools.owner, t.devtools.driver];
---

<section id="development" class="section overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading
      eyebrow={t.devtools.eyebrow}
      title={t.devtools.title}
      subtitle={t.devtools.subtitle}
    />

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      {
        tools.map((tool, index) => (
          <article class="reveal card card-hover overflow-hidden p-6 sm:p-8" data-delay={index * 90}>
            <div class="relative z-10">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-mono text-[0.68rem] font-medium uppercase tracking-[0.16em] text-jade-600">
                    {tool.label}
                  </p>
                  <h3 class="mt-2 font-mono text-2xl font-semibold tracking-tight text-fg sm:text-3xl">
                    {tool.title}
                  </h3>
                </div>
                <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-jade-500/20 bg-jade-500/8 text-jade-600">
                  <Icon name={index === 0 ? 'cli' : 'bridge'} size={22} />
                </span>
              </div>

              <p class="mt-5 max-w-xl text-[0.95rem] leading-relaxed text-fg-muted">{tool.desc}</p>

              <div class="dark-surface mt-6 flex items-center gap-3 border border-white/8 px-4 py-3 shadow-lg shadow-black/8">
                <span class="h-2 w-2 shrink-0 rounded-full bg-jade-400 shadow-[0_0_12px_rgba(20,207,149,0.48)]" />
                <code class="min-w-0 overflow-x-auto whitespace-nowrap font-mono text-xs text-fg sm:text-sm">
                  {tool.command}
                </code>
              </div>

              <ul class="mt-6 grid gap-3 sm:grid-cols-3">
                {tool.bullets.map((bullet) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-fg-muted">
                    <Icon name="check" size={15} class="mt-0.5 shrink-0 text-jade-600" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-5 rounded-2xl border border-black/8 bg-white/55 p-5 sm:p-7">
      <p class="font-mono text-[0.68rem] font-medium uppercase tracking-[0.16em] text-fg-dim">
        {t.devtools.loopLabel}
      </p>
      <ol class="mt-4 grid gap-2 sm:grid-cols-5">
        {
          t.devtools.loop.map((step, index) => (
            <li class="group flex min-w-0 items-center gap-2 sm:gap-3">
              <div class="flex min-w-0 flex-1 items-center gap-3 rounded-xl border border-black/7 bg-white px-3.5 py-3 shadow-sm">
                <span class="font-mono text-[0.65rem] text-jade-600">{String(index + 1).padStart(2, '0')}</span>
                <span class="text-xs font-medium leading-tight text-fg sm:text-sm">{step}</span>
              </div>
              {index < t.devtools.loop.length - 1 && (
                <Icon name="arrow" size={14} class="hidden shrink-0 text-fg-dim sm:block" />
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="reveal mt-10">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <p class="font-mono text-[0.68rem] font-medium uppercase tracking-[0.16em] text-fg-dim">
          {t.devtools.familiesLabel}
        </p>
        <a
          href={guideUrl(lang, 'development-workflow')}
          class="inline-flex items-center gap-2 text-sm font-semibold text-jade-700 transition-colors hover:text-jade-600"
        >
          {t.devtools.cta}
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.devtools.families.map((family) => (
            <div class="rounded-xl border border-black/8 bg-black/[0.025] px-4 py-3.5">
              <code class="font-mono text-sm font-semibold text-fg">lxdev {family.name}</code>
              <p class="mt-1.5 text-xs leading-relaxed text-fg-muted">{family.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

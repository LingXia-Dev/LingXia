---
// Line-style feature icons (24px grid, stroke = currentColor).
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props;

const paths: Record<string, string> = {
  // four platforms / surfaces
  platforms: `
    <rect x="3" y="3" width="7.5" height="7.5" rx="2"/>
    <rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/>
    <rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/>
    <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/>`,
  // rust = gear
  rust: `
    <circle cx="12" cy="12" r="3.4"/>
    <path d="M12 2.5v2.4M12 19.1v2.4M21.5 12h-2.4M4.9 12H2.5M18.7 5.3l-1.7 1.7M7 17l-1.7 1.7M18.7 18.7 17 17M7 7 5.3 5.3"/>`,
  // bring your framework = connected components
  framework: `
    <rect x="3" y="3" width="7" height="7" rx="1.8"/>
    <rect x="14" y="14" width="7" height="7" rx="1.8"/>
    <path d="M10 6.5h4.5A2.5 2.5 0 0 1 17 9v4.5"/>
    <circle cx="6.5" cy="17.5" r="3"/>`,
  // view / logic split
  split: `
    <rect x="3" y="4" width="18" height="16" rx="2.5"/>
    <path d="M12 4v16"/>
    <path d="M6 9h3M6 12h3M15 9h3M15 14h3"/>`,
  // CLI / terminal
  cli: `
    <rect x="3" y="4" width="18" height="16" rx="2.5"/>
    <path d="M7 9.5 10 12l-3 2.5M13 15h4"/>`,
  // native extension / plug
  extend: `
    <path d="M9 3v3M15 3v3"/>
    <path d="M7 6h10v5a5 5 0 0 1-5 5 5 5 0 0 1-5-5z"/>
    <path d="M12 16v5"/>`,
  // bridge / data flow
  bridge: `
    <path d="M3 8h18M3 16h18"/>
    <path d="M8 8 6 16M16 8l2 8"/>`,
  // sparkle / ai
  sparkle: `
    <path d="M12 3l1.8 4.7L18.5 9.5 13.8 11.3 12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/>
    <path d="M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>`,
  // arrow
  arrow: `<path d="M5 12h14M13 6l6 6-6 6"/>`,
  // check
  check: `<path d="M20 6 9 17l-5-5"/>`,
  // copy
  copy: `
    <rect x="9" y="9" width="11" height="11" rx="2.2"/>
    <path d="M5 15V5a2 2 0 0 1 2-2h8"/>`,
  // external
  external: `<path d="M14 4h6v6M20 4l-9 9M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5"/>`,
  // book
  book: `<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20"/>`,
};

const inner = paths[name] ?? '';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
  set:html={inner}
/>

---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import PlatformIcon from './PlatformIcon.astro';
import type { Lang, T } from '~/i18n/ui';

interface Props {
  t: T;
  lang: Lang;
}
const { t } = Astro.props;

const platformNames = ['android', 'ios', 'macos', 'windows', 'harmony'] as const;
---

<section id="features" class="section">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.features.eyebrow} title={t.features.title} subtitle={t.features.subtitle} />

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.features.items.map((f, i) => (
          <div class="reveal" data-delay={(i % 3) * 80}>
            <div class="card card-hover group relative flex h-full flex-col overflow-hidden p-6 sm:p-7">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-fg/10 bg-gradient-to-b from-fg/[0.03] to-transparent text-jade-600 transition-colors group-hover:text-jade-500">
                <Icon name={f.icon} size={24} />
              </span>
              <h3 class="mt-5 font-display text-lg font-semibold text-fg">{f.title}</h3>
              <p class="mt-2.5 text-[0.95rem] leading-relaxed text-fg-muted">{f.desc}</p>
              {f.icon === 'platforms' && (
                <div class="mt-auto flex items-center gap-3 pt-5 text-fg-dim" aria-hidden="true">
                  {platformNames.map((p) => (
                    <PlatformIcon name={p} size={20} />
                  ))}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "types": ["@lingxia/types", "@lingxia/types/logic-globals"]
  },
  "include": [
    "lxapp.ts",
    "pages/**/*.ts",
    "shared/display-language.ts",
    "shared/lib/**/*.ts",
    ".lingxia/types/**/*.d.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2020"], "strict": true, "noEmit": true, "skipLibCheck": true, "types": [],
    "resolveJsonModule": true,
    // The backlog registry is a plain `.mjs` module.
    "allowJs": true, "checkJs": false
  },
  "include": ["**/*.ts"]
}

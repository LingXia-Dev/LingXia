<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>app.lingxia.example.lxapp</string>

    <!-- Supported localizations -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
    </array>

    <!-- Push Notifications Configuration -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <!-- Location permission description for runtime prompts (required for WiFi info access) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Location access is needed to get your location and read Wi-Fi information.</string>

    <!-- Local network access (dev tooling connects to the Mac dev server);
         without this key iOS silently denies LAN connections with no prompt. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Local network access is needed to connect to the development server.</string>

    <!-- Photos library permission descriptions -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Photo library access is needed to save photos and videos.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Photo library access is needed to pick photos and videos.</string>

    <!-- Camera and microphone permission descriptions -->
    <key>NSCameraUsageDescription</key>
    <string>Camera access is needed to take photos and video in this page.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Microphone access is needed to record audio in this page.</string>

    <!-- Allow runtime orientation lock APIs to switch between portrait and landscape -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>

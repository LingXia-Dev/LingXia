{
  "name": "lingxia-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "lingxia build",
    "typecheck": "lingxia check",
    "test:automation": "lxdev test --preset portable",
    "test:automation:macos": "lxdev test --preset macos",
    "test:automation:windows": "lxdev test --preset windows",
    "test:automation:android": "lxdev test --preset android",
    "test:automation:ios": "lxdev test --preset ios",
    "test:automation:harmony": "lxdev test --preset harmony",
    "test:automation:report": "lxdev test report --failures",
    "test:automation:logic-coverage": "node tests/scripts/check-logic-api-coverage.mjs",
    "test:automation:backlog-stubs": "node tests/scripts/check-backlog-stubs.mjs",
    "test:automation:covers": "node tests/scripts/check-covers.mjs",
    "test:automation:argument-coverage": "node tests/scripts/check-argument-coverage.mjs",
    "test:automation:types": "npm run test:automation:logic-coverage && npm run test:automation:argument-coverage && npm run test:automation:backlog-stubs && tsc --noEmit -p tests/tsconfig.json",
    "test:harness": "node --test tests/harness/*.test.mjs"
  },
  "dependencies": {
    "@lingxia/view": "file:../../../packages/lingxia-view",
    "@liulidesign/core": "file:../../../packages/liuli/core"
  },
  "devDependencies": {
    "@lingxia/logic": "file:../../../packages/lingxia-logic",
    "@lingxia/types": "file:../../../packages/lingxia-types",
    "typescript": "^5.7.2",
    "@lingxia/test": "file:../../../packages/lingxia-test"
  }
}

{
  "name": "lingxia-showcase",
  "version": "1.0.0",
  "description": "LingXia Showcase LxApp",
  "type": "module",
  "keywords": [
    "lingxia",
    "miniapp"
  ],
  "author": "LingXia Team",
  "license": "MIT",
  "scripts": {
    "test:automation": "npm run test:automation:portable",
    "test:automation:portable": "lxdev test tests/all.test.ts --forbid-only",
    "test:automation:windows:react": "lxdev test tests/entries/windows.test.ts --arg platform=windows --arg framework=react --forbid-only",
    "test:automation:windows:vue": "lxdev test tests/entries/windows.test.ts --arg platform=windows --arg framework=vue --forbid-only",
    "test:automation:macos:react": "lxdev test tests/entries/macos.test.ts --arg platform=macos --arg framework=react --forbid-only",
    "test:automation:macos:vue": "lxdev test tests/entries/macos.test.ts --arg platform=macos --arg framework=vue --forbid-only",
    "test:automation:android:react": "lxdev test tests/entries/android.test.ts --arg platform=android --arg framework=react --forbid-only",
    "test:automation:android:vue": "lxdev test tests/entries/android.test.ts --arg platform=android --arg framework=vue --forbid-only",
    "test:automation:logic-coverage": "node tests/scripts/check-logic-api-coverage.mjs",
    "test:automation:backlog-stubs": "node tests/scripts/check-backlog-stubs.mjs",
    "test:automation:covers": "node tests/scripts/check-covers.mjs",
    "test:automation:types": "npm run test:automation:logic-coverage && tsc -p tests/tsconfig.json",
    "test:harness": "node --test tests/harness/*.test.mjs"
  },
  "dependencies": {
    "@lingxia/bridge": "file:../../../packages/lingxia-bridge",
    "@lingxia/react": "file:../../../packages/lingxia-react",
    "@lingxia/vue": "file:../../../packages/lingxia-vue",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lingxia-types": "file:../../../packages/lingxia-types",
    "lodash-es": "^4.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@lingxia/test": "file:../../../packages/lingxia-test",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "rolldown": "^1.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}

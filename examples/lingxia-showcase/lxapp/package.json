{
  "name": "lingxia-showcase",
  "version": "1.0.0",
  "description": "LingXia Showcase LxApp",
  "type": "module",
  "keywords": [
    "lingxia",
    "miniapp"
  ],
  "author": "LingXia Team",
  "license": "MIT",
  "scripts": {
    "test:automation": "npm run test:automation:portable",
    "test:automation:portable": "lxdev test --preset portable",
    "test:automation:windows": "lxdev test --preset windows",
    "test:automation:macos": "lxdev test --preset macos",
    "test:automation:android": "lxdev test --preset android",
    "test:automation:report": "lxdev test report --failures",
    "test:automation:logic-coverage": "node tests/scripts/check-logic-api-coverage.mjs",
    "test:automation:backlog-stubs": "node tests/scripts/check-backlog-stubs.mjs",
    "test:automation:covers": "node tests/scripts/check-covers.mjs",
    "test:automation:types": "npm run test:automation:logic-coverage && npm run test:automation:backlog-stubs && tsc -p tests/tsconfig.json",
    "test:harness": "node --test tests/harness/*.test.mjs",
    "typecheck": "tsc -b tsconfig.logic.json"
  },
  "dependencies": {
    "@lingxia/bridge": "file:../../../packages/lingxia-bridge",
    "@lingxia/react": "file:../../../packages/lingxia-react",
    "@lingxia/types": "file:../../../packages/lingxia-types",
    "@radix-ui/react-slot": ">=1.3.3",
    "@tailwindcss/postcss": ">=4.3.3",
    "class-variance-authority": ">=0.7.1",
    "clsx": ">=2.1.1",
    "echarts": ">=6.1.0",
    "lodash-es": ">=4.18.1",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8",
    "tailwindcss": ">=4.3.3"
  },
  "devDependencies": {
    "@lingxia/test": "file:../../../packages/lingxia-test",
    "@types/lodash-es": ">=4.17.12",
    "@types/react": ">=19.2.18",
    "@types/react-dom": ">=19.2.5",
    "@vitejs/plugin-react": ">=6.1.1",
    "autoprefixer": ">=10.5.4",
    "postcss": ">=8.5.26",
    "rolldown": ">=1.2.6",
    "typescript": ">=7.0.2",
    "vite": ">=8.2.2"
  }
}

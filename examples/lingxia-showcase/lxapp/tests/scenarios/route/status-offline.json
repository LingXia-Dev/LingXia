{
  "$schema": "../../../../../../packages/lingxia-test/schemas/scenario.schema.json",
  "name": "Status offline",
  "description": "The route status endpoint reports the service offline; device reads carry a stale lastSeen.",
  "http": {
    "routes": [
      {
        "url": "https://api.example.com/lingxia-showcase/route/status",
        "status": 503,
        "json": { "up": false, "checkedAt": "{{now}}" }
      },
      {
        "url": "https://api.example.com/lingxia-showcase/route/devices/*",
        "json": { "id": "d1", "online": false, "lastSeen": "{{now-6h}}" }
      }
    ]
  }
}

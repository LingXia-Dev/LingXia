{
  "extends": "./.lingxia/tsconfig.view.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.view.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "paths": { "@lingxia/view": ["../../../packages/lingxia-view/src/index.d.ts"] }
  },
  "files": ["./.lingxia/run-lingxia-gen-types.d.ts"],
  "include": ["pages/**/*.tsx", "shared/**/*.tsx", "shared/**/*.ts", ".lingxia/types/**/*.d.ts", ".lingxia/types/**/$types.ts"],
  "exclude": ["shared/lib/**"],
  "references": [{ "path": "./tsconfig.logic.json" }]
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.view.tsbuildinfo",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "pages/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    ".lingxia/types/**/*.d.ts",
    "global.d.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}

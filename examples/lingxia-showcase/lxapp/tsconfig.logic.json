{
  "extends": "./.lingxia/tsconfig.logic.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./.lingxia/logic-decl",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.logic.tsbuildinfo"
  },
  "files": ["./.lingxia/run-lingxia-gen-types.d.ts"],
  "include": [
    "lxapp.ts",
    "logic/**/*.ts",
    "pages/**/*.ts",
    "shared/*-types.ts",
    "shared/lib/**/*.ts",
    ".lingxia/types/**/*.d.ts",
    ".lingxia/logic-types/**/*.d.ts"
  ]
}

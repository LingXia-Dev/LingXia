    "./Button/recipe": "./src/Button/Button.recipe.ts",
    "./Field": "./src/Field/Field.tsx",
    "./Field/recipe": "./src/Field/Field.recipe.ts",
    "./TextInput": "./src/TextInput/TextInput.tsx",
    "./TextInput/recipe": "./src/TextInput/TextInput.recipe.ts",
    "./CheckboxInput": "./src/CheckboxInput/CheckboxInput.tsx",
    "./CheckboxInput/recipe": "./src/CheckboxInput/CheckboxInput.recipe.ts",
    "./Dialog": "./src/Dialog/Dialog.tsx",
    "./Dialog/recipe": "./src/Dialog/Dialog.recipe.ts",
    "./DropdownMenu": "./src/DropdownMenu/DropdownMenu.tsx",
    "./DropdownMenu/recipe": "./src/DropdownMenu/DropdownMenu.recipe.ts",
    "./package.json": "./package.json"
  },
  "lingxia": {
    "tokens": "./tokens.css"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"

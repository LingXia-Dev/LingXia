{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "../../target/lingxia-bridge-v3-test",
    "rootDir": "test-support",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["test-support/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

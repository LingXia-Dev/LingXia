{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxia.app/schemas/scenario.schema.json",
  "title": "LingXia scenario",
  "description": "A product state for `lxdev scenario use` and `t.app.network.scenario()`: HTTP routes that answer the lxapp's Logic fetch and Rong.SSE. Routes sit at the top level or under `http.routes`.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "Shown by `lxdev scenario list|status` and in the session log." },
    "description": { "type": "string", "description": "Shown by `lxdev scenario list`." },
    "routes": { "$ref": "#/$defs/routes" },
    "http": {
      "type": "object",
      "description": "The HTTP section: routes answering Logic fetch and Rong.SSE.",
      "properties": { "routes": { "$ref": "#/$defs/routes" } },
      "required": ["routes"],
      "additionalProperties": false
    },
    "worker": {
      "description": "Reserved for Worker-backed state. Not supported yet: a scenario with this section is rejected."
    }
  },
  "additionalProperties": false,
  "oneOf": [
    { "required": ["routes"], "not": { "required": ["http"] } },
    { "required": ["http"], "not": { "required": ["routes"] } }
  ],
  "$defs": {
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "description": "The first matching route answers.",
      "items": { "$ref": "#/$defs/route" }
    },
    "route": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "description": "A URL glob (`**/v1/status`) or a regex written `/source/flags`." },
        "method": { "type": "string", "description": "HTTP method; omitted or `*` matches any." },
        "times": { "type": "integer", "minimum": 1, "description": "Stop matching after this many requests." },
        "note": { "type": "string" },
        "description": { "type": "string" },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "description": "Answers served in call order; the last one repeats.",
          "items": { "$ref": "#/$defs/answer" }
        },
        "status": true, "statusText": true, "headers": true, "body": true, "json": true,
        "bodyBase64": true, "contentType": true, "delay": true,
        "abort": true, "continue": true, "hang": true, "patchJson": true, "sse": true
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/answerFields" }]
    },
    "answer": {
      "type": "object",
      "properties": {
        "status": true, "statusText": true, "headers": true, "body": true, "json": true,
        "bodyBase64": true, "contentType": true, "delay": true,
        "abort": true, "continue": true, "hang": true, "patchJson": true, "sse": true
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/answerFields" }]
    },
    "answerFields": {
      "properties": {
        "status": { "type": "integer", "minimum": 200, "maximum": 599 },
        "statusText": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" },
        "json": { "description": "Serialized as the JSON body." },
        "bodyBase64": { "type": "string", "description": "A binary body." },
        "contentType": { "type": "string" },
        "delay": { "type": "integer", "minimum": 0, "maximum": 30000, "description": "Milliseconds before the answer." },
        "abort": { "const": "failed" },
        "continue": { "const": true },
        "hang": { "const": true },
        "patchJson": { "description": "Merged into the real JSON response; needs `continue: true`." },
        "sse": {
          "type": "array",
          "description": "A text/event-stream answer.",
          "items": { "$ref": "#/$defs/sseStep" }
        }
      }
    },
    "sseStep": {
      "type": "object",
      "properties": {
        "event": { "type": "string" },
        "data": {},
        "id": { "type": "string" },
        "retry": { "type": "integer", "minimum": 0 },
        "comment": { "type": "string" },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "drop": { "const": true }
      },
      "additionalProperties": false
    }
  }
}

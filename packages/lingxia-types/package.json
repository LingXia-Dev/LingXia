{
  "name": "@lingxia/types",
  "version": "0.30.0",
  "description": "TypeScript type definitions for the LingXia JS API",
  "repository": {
    "type": "git",
    "url": "https://github.com/LingXia-Dev/LingXia.git",
    "directory": "packages/lingxia-types"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./logic-globals": {
      "types": "./dist/logic-globals.d.ts"
    },
    "./mocks": {
      "types": "./dist/mocks.d.ts"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "import": "./dist/esm/automation/index.js",
      "require": "./dist/automation/index.js"
    },
    "./testing": {
      "types": "./dist/testing/public-api.d.ts",
      "import": "./dist/esm/testing/public-api.js",
      "require": "./dist/testing/public-api.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/esm/error.js",
      "require": "./dist/error.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "import": "./dist/esm/time.js",
      "require": "./dist/time.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/esm/format.js",
      "require": "./dist/format.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/esm/page.js",
      "require": "./dist/page.js"
    },
    "./api.json": "./dist/api.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "gen:i18n": "node scripts/gen-i18n.mjs",
    "gen:logic": "node scripts/gen-logic.mjs",
    "gen": "npm run gen:i18n && npm run gen:logic",
    "check:logic": "npm run gen:logic -- --check",
    "check:quality": "node scripts/check-generated-quality.mjs && node scripts/check-api-style.mjs && node scripts/check-twins.mjs && node scripts/emit-api-json.mjs --check && node scripts/check-doc-refs.mjs",
    "gen:api": "node scripts/check-api-style.mjs --write && node scripts/emit-api-json.mjs",
    "check:esm": "node scripts/check-esm-exports.mjs",
    "test:types": "tsc -p tests/tsconfig.json && tsc -p tests/registry/tsconfig.json && node scripts/check-examples.mjs",
    "test:runtime": "npm run build && node tests/error-runtime.mjs && node tests/page-runtime.mjs && node tests/app-runtime.mjs && node tests/time-runtime.mjs && node tests/format-runtime.mjs && npm run check:esm",
    "build": "tsc && tsc -p tsconfig.esm.json && node scripts/copy-static-types.mjs && node scripts/emit-api-json.mjs --out dist/api.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "keywords": [
    "lingxia",
    "lxapp",
    "miniapp",
    "types",
    "typescript",
    "definitions"
  ],
  "author": "LingXia Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false
}

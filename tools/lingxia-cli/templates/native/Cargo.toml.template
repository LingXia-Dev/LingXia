[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2024"
description = "Native library for LingXia App (builds to .so/.a)"
build = "build.rs"

[lib]
name = "lingxia"
# cdylib for Android/Harmony (.so), staticlib for iOS/macOS (.a), rlib for Windows host deps.
crate-type = ["cdylib", "staticlib", "rlib"]

[features]
default = {{HOST_DEFAULT_FEATURES}}
standard = ["lingxia/standard"]
browser-shell = ["lingxia/browser-shell", "webview-input", "standard"]
terminal-runtime = ["lingxia/terminal-runtime"]
process = ["lingxia/process", "standard"]
# The local control socket, derived from appUse/computerUse/browserUse. Separate
# from devtools so a shipped product gets the handlers without the dev websocket
# and its TLS stack.
control = ["dep:lingxia-control-runtime", "dep:log", "lingxia/devtool", "lingxia-control-runtime/local-control", "lingxia/product-cli"]
computer-use = ["control", "lingxia/computer-use", "lingxia-control-runtime/computer-use"]
# Derived from `capabilities.browserUse`. Without it the browser handlers are
# not linked and every browser command answers "feature unavailable".
browser-use = ["control", "lingxia-control-runtime/browser"]
devtools = ["dep:lingxia-control-runtime", "lingxia/devtool", "lingxia-control-runtime/dev-bridge", "lingxia-control-runtime/browser", "lingxia-control-runtime/test-runtime"]
webview-input = ["lingxia/webview-input"]
cloud = []  # activated by `--with-provider cloud`

[dependencies]
lingxia = { version = "{{LINGXIA_VERSION}}", default-features = false, features = {{LINGXIA_DEP_FEATURES}} }
lingxia-control-runtime = { version = "{{LINGXIA_VERSION}}", optional = true, default-features = false }
log = { version = "0.4", optional = true }

[build-dependencies]
lingxia-native-codegen = { version = "{{LINGXIA_VERSION}}" }

# Platform-specific dependencies for FFI
{{ANDROID_DEPS_BLOCK}}
{{HARMONY_DEPS_BLOCK}}

# Release profile: optimize for size
[profile.release]
opt-level = 'z'
lto = true
codegen-units = 1
strip = true

[package]
name = "{{WINDOWS_CRATE_NAME}}"
version = "0.1.0"
edition = "2024"

[[bin]]
name = "{{WINDOWS_EXECUTABLE_NAME}}"
path = "src/main.rs"

[features]
default = ["standard"]
standard = ["host/standard", "lingxia-windows-sdk/standard"]
browser-shell = ["host/browser-shell", "lingxia-windows-sdk/browser-shell"]
terminal-runtime = ["host/terminal-runtime", "lingxia-windows-sdk/terminal-runtime"]
process = ["host/process"]
# Derived from `capabilities.*Use`. The executable is also the product's
# command line, so these have to reach the host crate that implements it.
control = ["host/control"]
computer-use = ["host/computer-use"]
browser-use = ["host/browser-use"]
devtools = ["host/devtools"]
webview-input = ["host/webview-input", "lingxia-windows-sdk/webview-input"]
cloud = ["host/cloud"]  # activated by `--with-provider cloud`

[dependencies]
lingxia-windows-sdk = { workspace = true }
host = { workspace = true }
tinyvec = { workspace = true }

[build-dependencies]
lingxia-windows-build = { workspace = true }

{
  "app": {
    "bundleName": "{{PACKAGE_ID}}",
    "vendor": "",
    "versionCode": 1000000,
    "versionName": "1.0.0",
    // vendor is overwritten at `lingxia build` from harmony.vendor, and
    // versionName / versionCode from app.productVersion. These values are
    // scaffold placeholders.
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}

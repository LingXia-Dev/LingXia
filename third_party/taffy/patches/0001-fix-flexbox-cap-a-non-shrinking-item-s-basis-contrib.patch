From 96d9f83278ef657f5d6dc7345941bc2b2426dcf8 Mon Sep 17 00:00:00 2001
From: Michael <michael@lingxia.app>
Date: Wed, 28 Oct 2026 12:10:55 -0700
Subject: [PATCH 1/2] fix(flexbox): cap a non-shrinking item's basis
 contribution by its max size

With flex-shrink: 0 the flex basis became the item's minimum content contribution even
when it exceeded the item's max size, so an auto-sized container grew to the unclamped
basis while the item itself was laid out at its max. Chrome and Firefox clamp the
hypothetical main size first.
---
 src/compute/flexbox.rs             |  4 ++-
 tests/aspect_ratio_max_transfer.rs | 40 ++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+), 1 deletion(-)
 create mode 100644 tests/aspect_ratio_max_transfer.rs

diff --git a/src/compute/flexbox.rs b/src/compute/flexbox.rs
index 47797b43..3dd10fb6 100644
--- a/src/compute/flexbox.rs
+++ b/src/compute/flexbox.rs
@@ -1373,7 +1373,9 @@ fn determine_container_main_size(
                         // Issue: https://github.com/w3c/csswg-drafts/issues/1435
                         // Gentest: padding_border_overrides_size_flex_basis_0.html
                         let clamping_basis = Some(item.flex_basis).maybe_max(style_preferred);
-                        let flex_basis_min = clamping_basis.filter(|_| item.flex_shrink == 0.0);
+                        // An item that cannot shrink contributes at least its basis, but never
+                        // more than its max size (Chrome and Firefox clamp the hypothetical size).
+                        let flex_basis_min = clamping_basis.maybe_min(style_max).filter(|_| item.flex_shrink == 0.0);
                         let flex_basis_max = clamping_basis.filter(|_| item.flex_grow == 0.0);
 
                         let min_main_size = style_min
diff --git a/tests/aspect_ratio_max_transfer.rs b/tests/aspect_ratio_max_transfer.rs
new file mode 100644
index 00000000..cc589d69
--- /dev/null
+++ b/tests/aspect_ratio_max_transfer.rs
@@ -0,0 +1,40 @@
+//! An auto-height flex column around an aspect-ratio item whose width is capped by `max-width`.
+use taffy::prelude::*;
+
+fn column_height(shrink: f32, item_max_height: Option<f32>) -> (f32, Size<f32>) {
+    let mut tree: TaffyTree<()> = TaffyTree::new();
+    let item = tree
+        .new_leaf(Style {
+            size: Size { width: percent(1.0), height: auto() },
+            max_size: Size { width: length(240.0), height: item_max_height.map(length).unwrap_or(auto()) },
+            aspect_ratio: Some(1.0),
+            flex_shrink: shrink,
+            ..Default::default()
+        })
+        .unwrap();
+    let column = tree
+        .new_with_children(
+            Style { flex_direction: FlexDirection::Column, flex_shrink: shrink, ..Default::default() },
+            &[item],
+        )
+        .unwrap();
+    let root = tree
+        .new_with_children(
+            Style {
+                flex_direction: FlexDirection::Column,
+                size: Size { width: length(327.0), height: auto() },
+                ..Default::default()
+            },
+            &[column],
+        )
+        .unwrap();
+    tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+    (tree.layout(column).unwrap().size.height, tree.layout(item).unwrap().size)
+}
+
+#[test]
+fn a_non_shrinking_items_basis_contribution_is_capped_by_its_max_size() {
+    let (column, item) = column_height(0.0, Some(240.0));
+    assert_eq!(item.height, 240.0);
+    assert_eq!(column, 240.0);
+}

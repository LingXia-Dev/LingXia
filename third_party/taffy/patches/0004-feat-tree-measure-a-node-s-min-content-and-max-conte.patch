+    /// Each node's border-box width sized by its content alone, under min-content and then
+    /// max-content available space: `[min, max]` per node, in the order given.
+    pub fn intrinsic_widths_with_measure<MeasureFunction>(
+        &mut self,
+        nodes: &[NodeId],
+        measure_function: MeasureFunction,
+    ) -> Vec<[f32; 2]>
+    where
+        MeasureFunction: FnMut(LayoutInput, NodeId, Option<&mut NodeContext>, &Style) -> LayoutOutput,
+    {
+        let mut taffy_view = TaffyView { taffy: self, measure_function };
+        nodes
+            .iter()
+            .map(|&node| {
+                [AvailableSpace::MinContent, AvailableSpace::MaxContent].map(|width| {
+                    taffy_view.measure_child_size(
+                        node,
+                        Size::NONE,
+                        Size::NONE,
+                        Size { width, height: AvailableSpace::MaxContent },
+                        SizingMode::ContentSize,
+                        AbsoluteAxis::Horizontal,
+                        Line::FALSE,
+                    )
+                })
+            })
+            .collect()
+    }
+

+//! A sizing pass keeps no layout: flexbox baseline alignment lays out a row's children even when
+//! the row is only being sized, and that layout must not outlive the pass.
+use taffy::prelude::*;
+use taffy::tree::LayoutOutput;
+
+/// Text whose min-content width is 30 and max-content width 100, 10 high per line.
+fn measure(known: Size<Option<f32>>, available: Size<AvailableSpace>) -> Size<f32> {
+    let width = known.width.unwrap_or(match available.width {
+        AvailableSpace::MinContent => 30.0,
+        AvailableSpace::MaxContent => 100.0,
+        AvailableSpace::Definite(width) => width.clamp(30.0, 100.0),
+    });
+    Size { width, height: known.height.unwrap_or((100.0 / width).ceil() * 10.0) }
+}
+
+fn layout(tree: &mut TaffyTree<bool>, root: NodeId) {
+    tree.compute_layout_with_measure(
+        root,
+        Size { width: AvailableSpace::Definite(120.0), height: AvailableSpace::MaxContent },
+        |inputs, _, context, _| {
+            LayoutOutput::from_outer_size(match context {
+                Some(&mut true) => measure(inputs.known_dimensions, inputs.available_space),
+                _ => Size::ZERO,
+            })
+        },
+    )
+    .unwrap();
+}
+
+/// A text beside a figure on one baseline, in a column that grows in a 120-wide row: to find the
+/// column's automatic minimum, the row sizes it at its min-content width, which sizes the text's
+/// row there too.
+#[test]
+fn a_baseline_rows_children_keep_their_layout_after_an_ancestor_is_sized_again() {
+    let mut tree: TaffyTree<bool> = TaffyTree::new();
+    let sibling = tree
+        .new_leaf(Style { size: Size { width: length(10.0), height: length(10.0) }, ..Default::default() })
+        .unwrap();
+    let text = tree.new_leaf_with_context(Style::default(), true).unwrap();
+    let cell = tree
+        .new_with_children(
+            Style {
+                flex_direction: FlexDirection::Column,
+                flex_grow: 1.0,
+                flex_shrink: 1.0,
+                min_size: Size { width: length(0.0), height: auto() },
+                ..Default::default()
+            },
+            &[text],
+        )
+        .unwrap();
+    let figure = tree
+        .new_leaf(Style {
+            flex_shrink: 0.0,
+            size: Size { width: length(40.0), height: length(10.0) },
+            ..Default::default()
+        })
+        .unwrap();
+    let line = tree
+        .new_with_children(
+            Style {
+                align_items: AlignItems::BASELINE,
+                gap: Size { width: length(12.0), height: zero() },
+                ..Default::default()
+            },
+            &[cell, figure],
+        )
+        .unwrap();
+    let column = tree
+        .new_with_children(
+            Style { flex_direction: FlexDirection::Column, flex_grow: 1.0, flex_shrink: 1.0, ..Default::default() },
+            &[sibling, line],
+        )
+        .unwrap();
+    let root = tree
+        .new_with_children(
+            Style { size: Size { width: length(120.0), height: auto() }, ..Default::default() },
+            &[column],
+        )
+        .unwrap();
+
+    for frame in 0..3 {
+        if frame > 0 {
+            // Only the sibling changes, so `line` keeps its cached final layout.
+            let width = 10.0 + frame as f32;
+            tree.set_style(
+                sibling,
+                Style { size: Size { width: length(width), height: length(10.0) }, ..Default::default() },
+            )
+            .unwrap();
+        }
+        layout(&mut tree, root);
+        let cell = tree.layout(cell).unwrap().size;
+        let text = tree.layout(text).unwrap().size;
+        assert_eq!(cell.width, 120.0 - 12.0 - 40.0, "frame {frame}: the cell takes the room beside the figure");
+        assert_eq!(
+            text,
+            Size { width: cell.width, height: 20.0 },
+            "frame {frame}: the text fills the cell on two lines"
+        );
+    }
+}

+/// Decoded PNG strikes by font id, font index, glyph id and strike ppem. A run reads a bitmap
+/// glyph's size before its atlas slot, so without this every draw decodes the PNG again.
+#[cfg(feature = "png")]
+fn decoded_png(key: (u64, u32, u32, u32), data: &[u8]) -> Option<Arc<Pixmap>> {
+    use std::sync::{Mutex, OnceLock};
+    /// Past this many strikes the cache starts over.
+    const ENTRIES: usize = 512;
+    type Strikes = std::collections::HashMap<(u64, u32, u32, u32), Arc<Pixmap>>;
+    static DECODED: OnceLock<Mutex<Strikes>> = OnceLock::new();
+    let decoded = DECODED.get_or_init(Default::default);
+    if let Some(pixmap) = decoded.lock().unwrap_or_else(|p| p.into_inner()).get(&key) {
+        return Some(Arc::clone(pixmap));
+    }
+    let pixmap = Arc::new(Pixmap::from_png(std::io::Cursor::new(data)).ok()?);
+    let mut decoded = decoded.lock().unwrap_or_else(|p| p.into_inner());
+    if decoded.len() >= ENTRIES {
+        decoded.clear();
+    }
+    decoded.insert(key, Arc::clone(&pixmap));
+    Some(pixmap)
+}
